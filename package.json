{
  "name": "@afkzona/groundwork",
  "version": "0.1.0",
  "description": "Open AI literacy course for Article 4 of the EU AI Act: Markdown modules with quizzes, an offline accessible course site, SCORM 1.2 and xAPI export, and tamper-evident training records.",
  "license": "AGPL-3.0-only",
  "author": "MB AFKzona Group",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afkzonagroup/groundwork.git"
  },
  "homepage": "https://github.com/afkzonagroup/groundwork#readme",
  "bugs": {
    "url": "https://github.com/afkzonagroup/groundwork/issues"
  },
  "keywords": [
    "ai-act",
    "ai-literacy",
    "article-4",
    "training",
    "scorm",
    "xapi",
    "e-learning",
    "eu",
    "offline"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "bin": {
    "groundwork": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "content/",
    "LICENSE",
    "LICENSE-CONTENT",
    "LICENSE-ADDITIONAL-TERMS.md",
    "COMMERCIAL.md",
    "TRADEMARKS.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
